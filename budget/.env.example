# TacEdge Budget — environment configuration
# Copy this file to .env and fill in the values from your Supabase project
# (Project settings → API). Never commit the real .env.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key. This is safe in the browser — Row Level
# Security restricts every table to the signed-in user. NEVER put the
# service-role key here or anywhere in this app.
VITE_SUPABASE_ANON_KEY=

# Optional: restrict the app to a single approved account. If set, a
# signed-in user with any other email is treated as signed out.
# For real enforcement also disable public sign-ups in Supabase
# (Authentication → Providers → Email → turn off "Allow new users to sign up")
# after creating your account.
VITE_ALLOWED_EMAIL=

# Optional: shown in Settings.
VITE_APP_VERSION=1.0.0
